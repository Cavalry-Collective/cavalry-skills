# Everything a tool writes for one machine mid-flight lives under .vstack/, one
# directory per tool. The rest of .vstack/ — pipeline.json, specs/, build/ — is
# the pipeline itself and belongs in the repo, so ignore the tool directories
# rather than the whole thing. They sit beside the artifact they belong to,
# hence the leading **/.

# wireframe: frozen versions, annotations, threads, and a `url` file naming a
# live localhost port.
**/.vstack/wireframe/

# The JSON-document skills keep theirs the same way: a seq counter, a `url` file
# naming a live port, and the version history behind the timeline.
**/.vstack/bridge/

.DS_Store
